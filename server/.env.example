DEMO_MODE=true
PORT=3001
HOST=127.0.0.1
# Required for DEMO_MODE=false. Never put these in the Expo env file.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_SUMMARY_MODEL=gpt-4.1-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_VERIFY_SERVICE_SID=
BACKEND_URL=https://your-backend.example.com
APP_URL=http://localhost:8081
# Comma-separated browser origins. Native clients do not send Origin.
CORS_ORIGINS=http://localhost:8081,http://localhost:8082
# At least 32 random characters, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
STREAM_SIGNING_SECRET=
MAX_CALL_SECONDS=900
MAX_DAILY_CALLS=5
# Real calls can only target the signed-in user's OTP-verified phone.
ALLOWED_PHONE_PREFIXES=+82
DEMO_DATA_FILE=./data/demo.sqlite
EXPO_ACCESS_TOKEN=

# Optional voice cloning (server only)
ELEVENLABS_API_KEY=
