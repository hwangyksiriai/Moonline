{
  "expo": {
    "name": "Moonline",
    "slug": "moonline",
    "scheme": "moonline",
    "version": "0.2.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.moonline.demo"
    },
    "android": {
      "package": "com.moonline.demo"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      "expo-font",
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "직접 목소리를 녹음할 때 마이크를 사용합니다.",
          "enableBackgroundRecording": false
        }
      ]
    ],
    "web": {
      "bundler": "metro"
    }
  }
}
